# Copy to .env and fill in. Never commit .env. Keep a copy of it somewhere safe:
# losing KEY_ENC_SECRET means every stored card key becomes unreadable.

# ---- Domains (point their DNS A records at the server first) ----
SITE_DOMAIN=tokard.ai
API_DOMAIN=api.tokard.ai
# new-api's own console, for you only
ADMIN_DOMAIN=admin.tokard.ai
# Who may open the admin console: your own IPs, space separated (CIDR)
ADMIN_ALLOW_IPS=203.0.113.7/32

# ---- Secrets: generate each one separately ----
#   openssl rand -hex 32      (for the hex ones)
#   openssl rand -base64 32   (for KEY_ENC_SECRET)
POSTGRES_PASSWORD=
REDIS_PASSWORD=
NEWAPI_SESSION_SECRET=
NEWAPI_CRYPTO_SECRET=
WEB_SESSION_SECRET=
# encrypts card keys at rest (AES-256-GCM); base64 of 32 random bytes
KEY_ENC_SECRET=

# ---- Card issuing ----
# In new-api, create a user just for issuing (e.g. "issuer"), give it enough quota,
# then in that user's settings create a personal access token with only the
# "API keys" scopes (view, edit, reveal). Nothing else. Paste it here.
ISSUER_TOKEN=

# ---- Payments (Stripe) ----
# Use a restricted key: Checkout Sessions write, Payment Intents read, Refunds write.
STRIPE_SECRET_KEY=
# Webhook endpoint: https://<SITE_DOMAIN>/api/stripe/webhook
# Events: checkout.session.completed, charge.refunded, charge.dispute.created
STRIPE_WEBHOOK_SECRET=

# ---- Sign-in email (Resend) ----
RESEND_API_KEY=
MAIL_FROM=Tokard <sign-in@tokard.ai>

# ---- Optional: Cloudflare Turnstile as a second check after the pixel puzzle ----
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ---- Prices ("face value:% off", comma separated) ----
# Coding 8.5 / 8 / 7.5折, Film 9 / 8.6 / 8.3折, Design at face value for now
SHOP_LADDER_TEXT=5:15,20:20,100:25
SHOP_LADDER_VIDEO=5:10,20:14,100:17
SHOP_LADDER_IMAGE=5:0,20:0,100:0
# gold within five: if this many flips in a row miss gold, the last one is a Lucky card
# at this share of face value (never below FLIP_FLOOR_RATIO)
PITY_EVERY=5
PITY_PRICE_RATIO=0.7
# half-price cards per day, sitewide
JACKPOTS_PER_DAY=20
# the Ultimate: one $100 card at $0.10 per this many cards sold; claimable after this much spending
ULTIMATE_EVERY=10000
ULTIMATE_NEED_USD=20
# when one is waiting, the chance a flip turns it over is 1 in ULTIMATE_ODDS
ULTIMATE_ODDS=1000

# ---- Studio trial (optional) ----
# a new-api key that lets signed-in visitors try Studio; empty = off
STUDIO_TRIAL_KEY=
STUDIO_TRIAL_PER_DAY=10
# 1 = allow video on the trial (videos cost the most)
STUDIO_TRIAL_VIDEO=0

# Proxies in front of the web container. Caddy alone = 1. Cloudflare + Caddy = 2.
TRUST_PROXY_HOPS=1

# Pin the gateway version. Upgrade on purpose, after reading its changelog.
NEWAPI_IMAGE=calciumion/new-api:v1.0.0-rc.46
